# DashScope / Qwen Configuration
DASHSCOPE_API_KEY=your_dashscope_api_key_here
AI_MODEL=qwen-max
# Optional OpenAI-compatible endpoint override
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# TMDB API (Optional)
TMDB_API_KEY=your_tmdb_api_key_here

# Letterboxd Authentication (Choose ONE method)

# Method 1: Username + Password (RECOMMENDED)
LETTERBOXD_USERNAME=your_letterboxd_username
LETTERBOXD_PASSWORD=your_password

# Method 2: Combined Credentials
# LETTERBOXD_CREDENTIALS=username:password

# Method 3: Cookie (Advanced - copy from browser after manual login)
# LETTERBOXD_COOKIE=letterboxd.session=xxx; persona=xxx; letterboxd.user.CURRENT=xxx

# Letterboxd Login Settings
LETTERBOXD_HEADLESS=false
LETTERBOXD_LOGIN_STRATEGY=auto
LETTERBOXD_LOGIN_FOR_READS=true
LETTERBOXD_LOGIN_WAIT_MS=20000
LETTERBOXD_INTERACTIVE_LOGIN_WAIT_MS=60000

# MCP Server Settings
PORT=3000
MCP_INIT_TIMEOUT_SEC=60
MCP_READY_TIMEOUT_SEC=30

# Debug Settings
DEBUG_TRACEBACK=true
CREW_VERBOSE=true

# DashScope / Qwen Configuration
DASHSCOPE_API_KEY=
AI_MODEL=qwen-max
# Optional OpenAI-compatible endpoint override
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# TMDB API (Optional)
TMDB_API_KEY=

# Portfolio-safe mode (recommended for screenshots and public demos)
# Uses fictional data and never starts Letterboxd MCP, Playwright, or a paid AI call.
MOVIE_REC_DEMO_MODE=true
MOVIE_REC_ALLOW_CONFIG_WRITE=false
MOVIE_REC_ALLOW_LETTERBOXD_READ=false
MOVIE_REC_ALLOW_LETTERBOXD_WRITE=false

# Local development only. Never collect or store visitor credentials on a public server.
# To use the legacy local integration, set MOVIE_REC_DEMO_MODE=false and explicitly
# enable only the capabilities you need.

# Letterboxd Authentication (choose at most one local-only method)
LETTERBOXD_USERNAME=
LETTERBOXD_PASSWORD=

# Method 2: Combined Credentials
# LETTERBOXD_CREDENTIALS=username:password

# Method 3: Cookie (advanced, local only; treat this value like a password)
# LETTERBOXD_COOKIE=letterboxd.session=xxx; persona=xxx; letterboxd.user.CURRENT=xxx

# Letterboxd Login Settings
LETTERBOXD_HEADLESS=true
LETTERBOXD_LOGIN_STRATEGY=auto
LETTERBOXD_LOGIN_FOR_READS=true
LETTERBOXD_LOGIN_WAIT_MS=20000
LETTERBOXD_INTERACTIVE_LOGIN_WAIT_MS=60000

# MCP Server Settings
PORT=3000
MCP_INIT_TIMEOUT_SEC=60
MCP_READY_TIMEOUT_SEC=30

# Debug Settings
DEBUG_TRACEBACK=false
CREW_VERBOSE=false
RECOMMENDATION_MAX_ATTEMPTS=2
